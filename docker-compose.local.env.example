# Copy this file to .env.local and provide your key. Bedrock Guardrail settings live in docker-compose.local.yml.
OPENAI_API_KEY=sk-your-key-here

# Local AWS credentials for Bedrock. Do not commit real values.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Local-only PostgreSQL credentials. They bootstrap development and test roles;
# never copy production URLs or credentials here.
LOCAL_POSTGRES_ADMIN_USER=chat_rag_admin
LOCAL_POSTGRES_ADMIN_PASSWORD=local-admin-password
LOCAL_MIGRATION_PASSWORD=local-migration-password
LOCAL_APP_PASSWORD=local-app-password
LOCAL_POSTGRES_PORT=5432
LOCAL_API_DATABASE_URL=postgresql://chat_rag_app:local-app-password@postgres:5432/postgres?sslmode=disable
LOCAL_MIGRATION_DATABASE_URL=postgresql://chat_rag_migrate:local-migration-password@localhost:5432/postgres?sslmode=disable
LOCAL_TEST_DATABASE_URL=postgresql://chat_rag_migrate:local-migration-password@localhost:5432/chat_rag_test?sslmode=disable
