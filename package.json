{
  "name": "chat-rag",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:api": "pnpm --filter @chat-rag/api dev",
    "build:api": "pnpm --filter @chat-rag/api build",
    "start:api": "pnpm --filter @chat-rag/api start",
    "typecheck:api": "pnpm --filter @chat-rag/api typecheck",
    "test:api": "pnpm --filter @chat-rag/api test -- --config vitest.config.ts",
    "dev:web": "pnpm --filter @chat-rag/web dev",
    "build:web": "pnpm --filter @chat-rag/web build",
    "typecheck:web": "pnpm --filter @chat-rag/web typecheck",
    "test:web": "pnpm --filter @chat-rag/web test -- --config vitest.config.ts",
    "test": "pnpm test:api && pnpm test:web",
    "eval:guardrails": "pnpm --filter @chat-rag/api eval:guardrails",
    "compose:local:up": "docker compose --env-file .env.local -f docker-compose.local.yml up --build",
    "compose:local:down": "docker compose --env-file .env.local -f docker-compose.local.yml down",
    "db:generate": "pnpm --filter @chat-rag/api db:generate",
    "db:migrate": "pnpm build:api && pnpm --filter @chat-rag/api db:migrate",
    "db:reset": "scripts/db-reset.sh"
  },
  "devDependencies": {
    "deepeval": "0.9.16"
  }
}
